{
  "name": "router-agent",
  "version": "0.1.0",
  "private": true,
  "description": "飞书消息 → 常驻 Router 研判 → 派发到 Orca worktree 内 Claude Code 执行 → PR 跟踪闭环的双层 Agent 系统",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ra": "bin/ra.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/build-web.mjs",
    "check": "pnpm typecheck && pnpm test",
    "start": "node dist/cli/index.js start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "7.8.6",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "commander": "12.1.0",
    "typebox": "1.1.24",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
