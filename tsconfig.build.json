{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "packages/*/src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "packages/*/src/**/*.test.ts", "src/web/client/**"]
}
