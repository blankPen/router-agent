  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@router-agent/core": "0.3.35",
    "@router-agent/infra": "0.3.35",
    "zod": "4.4.3"
