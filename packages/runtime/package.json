{
  "name": "@router-agent/runtime",
  "version": "0.3.35",
  "type": "module",
  "description": "Worker 运行时 SDK：端口、注册表、插件协议与共享工具",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blankPen/router-agent.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/blankPen/router-agent#readme",
  "bugs": {
    "url": "https://github.com/blankPen/router-agent/issues"
  },
  "main": "./dist/index.js",
  "exports": {
